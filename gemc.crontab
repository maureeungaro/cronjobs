SHELL=/bin/bash
PATH=/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=ungaro@jlab.org

# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * command to be executed

# sync artifacts to cvmfs from /work, can only be done in 2402
*/20 * * * * flock -n $HOME/.prio.lock $HOME/cronjobs/osg_fairshare.zsh  || { [ "$?" -eq 1 ] && echo "$(date) osg fairshare script skipped: lock busy" >> "$HOME/cronjobs/logs/fairshare.log"; }






