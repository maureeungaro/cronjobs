SHELL=/bin/bash
PATH=/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=baltzell@jlab.org,ungaro@jlab.org,devita@jlab.org
d=/scigroup/cvmfs/hallb/clas12/sw/noarch/clas12-utilities/dev/osg/bin
#
# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * user-name  command to be executed
# 8-59/10: starts at 8, then every 10 minutes after that, giving: 8,18,28,38,48,58.
#
# Cleanup:
8-59/10  * * * * rm /volatile/clas12/osg/osgLog.json /volatile/clas12/osg/osg-production.json /volatile/clas12/osg/osg-devel.json >& /dev/null
4        2 * * * $d/disk-cleanup.py -empty 90 -path /volatile/clas12/osg > /dev/null
#
# Transfer OSG metadata to web-accessible fileserver:
50 * * * * mv -f /volatile/clas12/osg/timeline.json /group/clas/www/clasweb-2015/html/clas12offline/osg/ >& /dev/null
0  8 * * * mv -f /volatile/clas12/osg/daily-digest/*.pdf /group/clas/www/clasweb-2015/html/clas12offline/osg/daily-digest/ >& /dev/null
#