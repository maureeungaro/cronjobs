SHELL=/bin/bash
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/opt/homebrew//bin/
MAILTO=ungaro@jlab.org

# run_with_lock_and_log is a wrapper that sends email only when there's an error
# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * command to be executed

cj=/opt/projects/cronjobs
4 * * * *  $cj/run_with_lock_and_log.zsh -l $cj/logs $cj/pull_cronjobs.zsh
12 * * * * $cj/run_with_lock_and_log.zsh -l $cj/logs $cj/sync_code_instructions.zsh





