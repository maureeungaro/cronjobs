SHELL=/bin/bash
PATH=/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=ungaro@jlab.org

# run_with_lock_and_log is a wrapper that sends email only when there's an error
# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * command to be executed

# calculate fairshare and write json file
# update portal software on dev and main
# update json files from /group
3-59/10  * * * * $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/cronjobs/update_data.zsh
6-59/10  * * * * $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/cronjobs/osg_fairshare.zsh /home/gemc/html/main/simGrid/web_portal/data
7-59/10  * * * * $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/html/main/simGrid/db_io/mark_completed_submissions.py --write-to-db
8-59/10  * * * * $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/html/dev/simGrid/db_io/mark_completed_submissions.py  --write-to-db --database CLAS12TEST
*/20     * * * * $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/cronjobs/update_portal_software.zsh
4,24,44  * * * * $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/cronjobs/pull_cronjobs.zsh


