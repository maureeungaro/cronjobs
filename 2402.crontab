SHELL=/bin/bash
PATH=/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=ungaro@jlab.org

# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * command to be executed

# sync artifacts from /work
*/10 * * * * flock -n $HOME/.cvmfs.lock $HOME/cronjobs/sync_staged_to_cvmfs.zsh  || echo "$(date) cvmfs sync artifact installed skipped: lock busy"







