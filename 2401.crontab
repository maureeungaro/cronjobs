SHELL=/bin/bash
PATH=/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=ungaro@jlab.org

# run_with_lock_and_log is a wrapper that sends email only when there's an error
# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * command to be executed

# osgLog.sh copies the query log from /volatile to the web location
# pull_clas12-config.sh syncs the osg portal clas12-config
01,11,21,31,41,51  *  *  *  * $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/cronjobs/osgLog.sh
20            1-23/2  *  *  *  $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/cronjobs/pull_clas12-config.sh
2,22,42            *  *  *  *   $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/cronjobs/pull_cronjobs.zsh
