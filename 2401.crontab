SHELL=/bin/bash
PATH=/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=ungaro@jlab.org

# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * command to be executed

# osgLog.sh copies the query log from /volatile to the web location
# pull_clas12-config.sh syncs the osg portal clas12-config
01,11,21,31,41,51   *  *  *  * flock -n $HOME/.osgl.lock $HOME/cronjobs/osgLog.sh             || { [ "$?" -eq 1 ] && echo "$(date) osg log skipped: lock busy"            >> "$HOME/cronjobs/logs/osglog.log"; }
20             1-23/2  *  *  *  flock -n $HOME/.c12c.lock $HOME/cronjobs/pull_clas12-config.sh || { [ "$?" -eq 1 ] && echo "$(date) pull clas12-config skipped: lock busy" >> "$HOME/cronjobs/logs/pull_c12c.log"; }
