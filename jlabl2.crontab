SHELL=/bin/bash
PATH=/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=ungaro@jlab.org

# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * command to be executed

# make sure clas12Tags is updaded, used for the next crontab
# stage artifacts in /work - notice because of firewall this only works on jlabl2
2 * * * *   flock -n "$HOME/.plots.lock" "$HOME/cronjobs/update_mauriplots_jlabl2.zsh" || { [ "$?" -eq 1 ] && echo "$(date) update_mauriplots_jlabl2 skipped: lock busy" >> "$HOME/cronjobs/cronplots.log"; }







