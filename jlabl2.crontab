SHELL=/bin/bash
PATH=/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=ungaro@jlab.org

# run_with_lock_and_log is a wrapper that sends email only when there's an error
# .---------------- minute (0 - 59)
# |  .------------- hour (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month (1 - 12) OR jan,feb,mar,apr ...
# |  |  |  |  .---- day of week (0 - 6) (Sunday=0 or 7) OR sun,mon,tue,wed,thu,fri,sat
# |  |  |  |  |
# *  *  *  *  * command to be executed

# stage artifacts in /work - notice because of firewall this only can only be done on jlabl2
2 * * * *   $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/cronjobs/update_mauriplots_jlabl2.zsh
42 */2 * * * $HOME/cronjobs/run_with_lock_and_log.zsh $HOME/cronjobs/sync_gemc_work_to_cvmfs.zsh







